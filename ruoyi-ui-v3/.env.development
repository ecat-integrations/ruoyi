# 页面标题
VITE_APP_TITLE = ECAT管理系统

# 开发环境配置
VITE_APP_ENV = 'development'

# 若依管理系统/开发环境
VITE_APP_BASE_API = '/dev-api'

# 登录：hybrid=表单+URL token；form=仅表单；auto_token=仅 token 自动登录
VITE_LOGIN_MODE = hybrid

# 是否预填账号密码（开发方便联调）
VITE_LOGIN_PREFILL = true
# 预填账号/密码（仅 PREFILL=true 时生效；长度需满足若依校验）
VITE_LOGIN_DEFAULT_USERNAME = Adminxxxxxxx
VITE_LOGIN_DEFAULT_PASSWORD = xxxxxxxxxxxx

# 是否允许 /login?token= 加密令牌自动登录
VITE_LOGIN_TOKEN_ENABLED = true
